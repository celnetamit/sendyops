# Environment Variables Template for Production

# ============================================
# SENDY DATABASE CONNECTION (REQUIRED)
# ============================================
DB_HOST=your_sendy_host.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=sendy
DB_PORT=3306

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================
# Generate: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# ============================================
# NEXTAUTH CONFIGURATION (REQUIRED)
# ============================================
NEXTAUTH_URL=https://yourdomain.com

# ============================================
# APP DATABASE (POSTGRESQL) - REQUIRED
# ============================================
POSTGRES_USER=sendyuser
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=sendydashboard
DATABASE_URL=postgresql://sendyuser:secure_password@db:5432/sendydashboard




